{
  "name": "mdmarufhossen-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal portfolio of Md Maruf Hossen — digital marketer, graphic designer and web builder from Gazipur, Bangladesh.",
  "license": "GPL-3.0-only",
  "author": "Md Maruf Hossen",
  "homepage": "https://mdmarufhossen.link",
